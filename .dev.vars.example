# Copy to .dev.vars for local development with `wrangler dev`.
# Never commit .dev.vars — it is gitignored.

# Required: GitHub login this worker serves stats for. This worker is
# single-user — there is no `username` query parameter at runtime.
GITHUB_USERNAME=your-github-login

# GitHub Personal Access Token(s). At least PAT_1 is required.
# Fine-grained recommended. Scopes: Repository Contents (Read), Metadata (Read).
PAT_1=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PAT_2=
# PAT_3=

# Optional: SVG cache TTL in seconds (default: 86400 = 1 day)
# CACHE_SECONDS=86400

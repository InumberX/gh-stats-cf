{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Change `name` to your own Worker name before deploying.
  "name": "gh-stats-cf",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  }
  // Set runtime secrets via `wrangler secret put`:
  //   wrangler secret put PAT_1
  //
  // Optional vars (uncomment to enable; trailing comma after the closing brace
  // above is valid in JSONC, so this block can be uncommented as-is):
  // ,"vars": {
  //   "CACHE_SECONDS": "86400",
  //   "WHITELIST": "your-github-login"
  // }
}
